SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_RECIPIENT_EMAIL=
NEWSLETTER_RECIPIENT_EMAIL=

# Dashboard Messages module (api/sync-mailboxes.js, api/send-message.js)
# SUPABASE_ANON_KEY is the same public/publishable anon key already used as
# admin/.env's VITE_SUPABASE_ANON_KEY — safe to duplicate here (it's not a
# secret), just needed under a plain name because Vercel Functions can't
# read the admin app's Vite-time env.
SUPABASE_ANON_KEY=
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
SALES_MAILBOX_PASSWORD=
OFFICE_MAILBOX_PASSWORD=
CRON_SECRET=
# Exact origin the admin dashboard is served from, e.g. https://admin.sellamre.com
# — required only if admin is a separate Vercel project/domain from this one,
# so its browser calls to /api/send-message and /api/sync-mailboxes are
# allowed through CORS. Leave unset if admin shares this exact origin.
ADMIN_ORIGIN=
